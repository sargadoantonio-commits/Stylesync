rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function userDocExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isBarber() {
      return signedIn() && userDocExists() && userRole() == 'barber';
    }

    function isShopOwner() {
      return signedIn() && userDocExists() && userRole() == 'shopOwner';
    }

    function isCustomer() {
      return signedIn() && userDocExists() && userRole() == 'customer';
    }

    function barberIsApproved(barberId) {
      return exists(/databases/$(database)/documents/barbers/$(barberId))
        && get(/databases/$(database)/documents/barbers/$(barberId)).data.verificationStatus == 'approved';
    }

    function shopOwnedByMe(shopId) {
      return exists(/databases/$(database)/documents/shops/$(shopId))
        && get(/databases/$(database)/documents/shops/$(shopId)).data.ownerId == request.auth.uid;
    }

    function barberIsAdminInShop(shopId) {
      let shopRef = /databases/$(database)/documents/shops/$(shopId);
      // Conservative check: treat requester as shop-level admin if they are a platform admin
      // or if they are the shop owner. This avoids unsupported list/lambda usage in rules.
      return exists(shopRef) && (
        // Platform-level admin flag on user's document
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
        // Or the shop owner
        || get(shopRef).data.ownerId == request.auth.uid
      );
    }

    function isApprovedBarber() {
      return isBarber() && barberIsApproved(request.auth.uid);
    }

    function rootCredentialUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['passwordHash', 'passwordSalt']);
    }

    match /users/{uid} {
      allow read: if isSelf(uid);
      allow create: if isSelf(uid)
        && request.resource.data.keys().hasAll(['username', 'email', 'role', 'isPremium'])
        && request.resource.data.username is string
        && request.resource.data.email is string
        && request.resource.data.role in ['barber', 'customer', 'shopOwner']
        && request.resource.data.isPremium is bool;
      // Clients cannot escalate role or directly tamper with XP/loyalty.
      allow update: if isSelf(uid)
        && request.resource.data.role == resource.data.role
        && request.resource.data.xp == resource.data.xp
        && request.resource.data.loyaltyRank == resource.data.loyaltyRank
        && rootCredentialUnchanged();
      allow delete: if false;

      // Server-only password material (Cloud Functions / Admin SDK).
      match /auth_private/{docId} {
        allow read, write: if false;
      }

      // `users/{uid}/suki_stats/{barberId}` updates must be server-side (Cloud Functions).
      match /suki_stats/{barberId} {
        allow read: if isSelf(uid);
        allow write: if false;
      }
    }

    // Single-document username resolution for pre-auth flows (listing blocked).
    // Abuse throttling metadata (Cloud Functions Admin SDK only).
    match /security_rate_limits/{id} {
      allow read, write: if false;
    }

    match /username_index/{uname} {
      allow get: if true;
      allow list: if false;
      // Public index: only routing fields (never password hashes).
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'email'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email is string;
      allow update: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'email'])
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Global barbers registry (multi-shop).
    // barbers/{barberId}: { shopId, name, verificationStatus, gcashQrUrl, reliabilityScore, phoneNumber? }
    match /barbers/{barberId} {
      allow read: if signedIn();
      // Barber can update their own non-sensitive fields after approval process,
      // but never their verificationStatus or reliabilityScore.
      allow update: if isSelf(barberId)
        && request.resource.data.verificationStatus == resource.data.verificationStatus
        && request.resource.data.reliabilityScore == resource.data.reliabilityScore;
      // Only shop owner can create/delete barbers under their own shop.
      allow create: if isShopOwner()
        && request.resource.data.shopId is string
        && shopOwnedByMe(request.resource.data.shopId);
      allow delete: if isShopOwner() && shopOwnedByMe(resource.data.shopId);
    }

    match /shops/{shopId} {
      allow read: if signedIn();
      // Only shop owners can create shop documents.
      allow create: if isShopOwner()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.keys().hasAll(['name', 'ownerId', 'address', 'totalRevenue']);
      // Shop owner or barber admin can update their shop, including barbers array
      // Additionally, allow clients to perform ticketCount-only updates (increment/decrement)
      // which are performed as part of join/leave queue transactions.
      allow update: if (
          (isShopOwner() && resource.data.ownerId == request.auth.uid
            && request.resource.data.ownerId == resource.data.ownerId)
          || barberIsAdminInShop(shopId)
        )
        || (
          // Allow ticketCount updates from signed-in users when only ticketCount/updatedAt
          // fields are modified (checked via diff) and the change is an increment or decrement by 1.
          signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ticketCount','updatedAt'])
          && request.resource.data.ticketCount is int
          && (
            // If the shop previously had a ticketCount, allow +1 or -1
            (resource.data.keys().hasAny(['ticketCount']) && (
              request.resource.data.ticketCount == resource.data.ticketCount + 1
              || request.resource.data.ticketCount == resource.data.ticketCount - 1
            ))
            // If there was no previous ticketCount, allow setting it to a non-negative integer
            || (!resource.data.keys().hasAny(['ticketCount']) && request.resource.data.ticketCount >= 0)
          )
        );
      allow delete: if false;

      match /queue/{ticketId} {
        allow read: if signedIn();
        // Simple, safe client create: only allow users to create their own ticket
        // and only with the expected fields.
        allow create: if signedIn()
          && request.auth.uid == request.resource.data.userId
          && request.resource.data.keys().hasOnly(['userId', 'username', 'isPremium', 'joinedAt'])
          && request.resource.data.userId is string
          && request.resource.data.username is string
          && request.resource.data.isPremium is bool
          && request.resource.data.joinedAt is timestamp;
        // Only the ticket owner can update/delete their ticket.
        allow update, delete: if signedIn() && request.auth.uid == resource.data.userId;
      }

      // Barber-direct handshake + server-authoritative payment confirmation.
      // shops/{shopId}/services/{serviceId}
      match /services/{serviceId} {
        allow read: if signedIn();

        // Create a service: approved barber or shop owner.
        allow create: if (isApprovedBarber() || isShopOwner())
          && request.resource.data.keys().hasAll(['shopId', 'barberId', 'customerId', 'amount', 'status', 'createdAt'])
          && request.resource.data.shopId == shopId;

        // Update (field-level):
        // - customer can only transition to payment_sent and set paymentSentAt
        // - barber can only confirm by setting paymentConfirmedAt / status
        // - shopOwner can update within their own shop
        allow update: if signedIn() && (
          (isCustomer() && resource.data.customerId == request.auth.uid
            && request.resource.data.barberId == resource.data.barberId
            && request.resource.data.customerId == resource.data.customerId
            && request.resource.data.amount == resource.data.amount
            && request.resource.data.paymentConfirmedAt == resource.data.paymentConfirmedAt
          )
          ||
          (isApprovedBarber() && resource.data.barberId == request.auth.uid
            && request.resource.data.barberId == resource.data.barberId
            && request.resource.data.customerId == resource.data.customerId
            && request.resource.data.amount == resource.data.amount
          )
          ||
          (isShopOwner() && shopOwnedByMe(shopId))
        );

        allow delete: if false;
      }
    }

    // Audit logs - Cloud Functions write only, admin/users can read own logs
    match /audit_logs/{logId} {
      // Clients cannot create/modify audit logs directly
      allow create, update, delete: if false;
      
      // Users can read their own audit logs
      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.email == request.auth.token.email
      );
    }

    // Security alerts - Cloud Functions write only, admins can read
    match /security_alerts/{alertId} {
      // Clients cannot create/modify security alerts
      allow create, update, delete: if false;
      
      // Only admins can read security alerts
      allow read: if signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Bookings collection: allow owners, related barbers, shop owners, and admins to read.
    // Customers can create their own bookings.
    match /bookings/{bookingId} {
      // Read a booking if the requester is an admin, the customer, the assigned barber,
      // an approved barber, or the shop owner for the booking's shop.
      allow read: if signedIn() && (
        // Platform admin
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
        // Owner of the booking (customer)
        || resource.data.customerId == request.auth.uid
        // Assigned barber
        || resource.data.barberId == request.auth.uid
        // Approved barber (global)
        || isApprovedBarber()
        // Shop owner or barber admin within the shop
        || shopOwnedByMe(resource.data.shopId)
        || barberIsAdminInShop(resource.data.shopId)
      );

      // Create: allow customers to create their own booking documents.
      allow create: if isCustomer()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.keys().hasAll(['customerId', 'shopId', 'barberId', 'status', 'createdAt']);

      // Allow customers to cancel their own booking by setting only the
      // `status` field to 'cancelled'. For local/dev flows we allow any
      // authenticated user whose UID matches the booking.customerId to
      // cancel (avoids requiring a separate users/ doc during emulator tests).
      allow update: if signedIn()
        && resource.data.customerId == request.auth.uid
        // Only allow changing the `status` field during this operation
        && request.resource.data.keys().hasOnly(['status'])
        && request.resource.data.status == 'cancelled';

      // Deletions are not allowed from clients
      allow delete: if false;
    }
  }
}
